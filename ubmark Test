ยืนยันลำดับขั้นตอนของคุณ
ถูกต้องครับ:
chmod +x umbmark_loop.py
Terminal 1: roscore
Terminal 2: roslaunch kobuki_node minimal.launch
Terminal 3: rostopic echo /odom (เช็คครั้งเดียวก่อนเริ่ม แล้ว Ctrl+C ปิดได้ ไม่ต้องเปิดค้างไว้)
Terminal 4: rosrun ... umbmark_loop.py --direction cw → วิ่งครบ 5 รอบ → ตารางสรุปโผล่ขึ้นมาอัตโนมัติให้ถ่ายรูป/จด
(ใช้ terminal เดิมหรือใหม่ก็ได้) rosrun ... umbmark_loop.py --direction ccw → ครบ 5 รอบ → สรุปตารางอีกครั้ง
python3 umbmark_calc.py --file umbmark_results.csv --L 4.0 --wheelbase 0.230 (ถ้าไฟล์ CSV อยู่บนเครื่องเดียวกัน สามารถรันต่อได้ทันทีโดยไม่ต้องย้ายไฟล์ไปเครื่องอื่นเลย)


#!/usr/bin/env python3
# umbmark_loop.py — เก็บข้อมูล UMBmark แบบวนลูป 5 รอบในการรันครั้งเดียว
# บันทึกเฉพาะคอลัมน์ตามตารางในคู่มือ (หัวข้อ 3.5):
#   รอบ, x_abs (m), y_abs (m), x_odom (m), y_odom (m), Δx = x_abs-x_odom, Δy
#
# หมายเหตุ: x_odom, y_odom ในตารางนี้ = ระยะที่ /odom รายงานว่าหุ่นเคลื่อนที่ไป
#           จากจุดเริ่มต้น (ไม่ใช่ตำแหน่งสัมบูรณ์บนแผนที่)
#
# วิธีใช้:
#   rosrun <your_package> umbmark_loop.py --direction cw
#   (พอครบ 5 รอบ cw แล้ว รันใหม่อีกทีด้วย --direction ccw สำหรับอีก 5 รอบ)
#
# ระหว่างที่โปรแกรมรอ input() หุ่นยนต์จะไม่เคลื่อนที่เด็ดขาด (ไม่มีการ publish cmd_vel)
# ต้องกด Enter เท่านั้นถึงไปต่อ กดปุ่มอื่นผิดไม่ทำให้หุ่นขยับหรือระบบพลาด

import rospy
import math
import csv
import os
import argparse
from nav_msgs.msg import Odometry
from geometry_msgs.msg import Twist

LINEAR_SPEED = 0.15
ANGULAR_SPEED = 0.3
SIDE_LEN = 4.0          # เปลี่ยนเป็น 3.0 ถ้าใช้สี่เหลี่ยม 3x3m
TURN_ANGLE = math.pi / 2
N_TRIALS = 5
RESULTS_FILE = "umbmark_results.csv"

latest_odom = None

def odom_callback(msg):
    global latest_odom
    latest_odom = msg.pose.pose

def get_odom(timeout=3.0):
    global latest_odom
    latest_odom = None
    t0 = rospy.Time.now().to_sec()
    while latest_odom is None and rospy.Time.now().to_sec() - t0 < timeout:
        rospy.sleep(0.05)
    return latest_odom

def move_straight(pub, dist, speed=LINEAR_SPEED):
    msg = Twist()
    msg.linear.x = speed
    duration = dist / speed
    t0 = rospy.Time.now().to_sec()
    while rospy.Time.now().to_sec() - t0 < duration and not rospy.is_shutdown():
        pub.publish(msg)
        rospy.sleep(0.05)
    pub.publish(Twist())
    rospy.sleep(0.5)

def turn(pub, angle, direction, speed=ANGULAR_SPEED):
    msg = Twist()
    msg.angular.z = -speed if direction == 'cw' else speed
    duration = angle / speed
    t0 = rospy.Time.now().to_sec()
    while rospy.Time.now().to_sec() - t0 < duration and not rospy.is_shutdown():
        pub.publish(msg)
        rospy.sleep(0.05)
    pub.publish(Twist())
    rospy.sleep(0.5)

def run_square(pub, direction):
    for i in range(4):
        rospy.loginfo(f"Leg {i+1}/4: straight {SIDE_LEN} m")
        move_straight(pub, SIDE_LEN)
        rospy.loginfo(f"Leg {i+1}/4: turn 90 deg {direction}")
        turn(pub, TURN_ANGLE, direction)

def append_row(row):
    file_exists = os.path.isfile(RESULTS_FILE)
    with open(RESULTS_FILE, 'a', newline='', encoding='utf-8') as f:
        writer = csv.writer(f)
        if not file_exists:
            writer.writerow(['รอบ', 'x_abs (m)', 'y_abs (m)', 'x_odom (m)', 'y_odom (m)', 'Δx (m)', 'Δy (m)'])
        writer.writerow(row)

def run_one_trial(pub, direction, trial_num):
    label = f"{direction.upper()} {trial_num}"
    print(f"\n=== รอบที่ {trial_num}/{N_TRIALS} | ทิศทาง: {direction.upper()} ===")
    input(">>> ตั้งหุ่นที่จุดเริ่มต้นให้ตรงเครื่องหมายบนพื้นแล้ว กด Enter เพื่อเริ่ม...")

    start = get_odom()
    if start is None:
        rospy.logerr("ไม่ได้รับ /odom เลย! ตรวจสอบ topic แล้วลองรอบนี้ใหม่")
        return False, None
    x0, y0 = start.position.x, start.position.y
    print(f"Odom เริ่มต้น: x={x0:.4f} y={y0:.4f}")

    print("กำลังวิ่งสี่เหลี่ยม...")
    run_square(pub, direction)

    rospy.sleep(0.5)
    end = get_odom()
    if end is None:
        rospy.logerr("ไม่ได้รับ /odom ตอนจบ! ข้อมูลรอบนี้อาจไม่สมบูรณ์")
        return False, None
    x1, y1 = end.position.x, end.position.y
    print(f"Odom สุดท้าย: x={x1:.4f} y={y1:.4f}")

    x_odom = x1 - x0   # ระยะที่ odom รายงานว่าเคลื่อนที่ไปจากจุดเริ่ม
    y_odom = y1 - y0
    print(f"x_odom={x_odom:.4f} y_odom={y_odom:.4f} (ควรใกล้ 0 ถ้า odom ไม่มี error)")

    print(">>> วัดตำแหน่งจริงของจุดกลางแกนล้อ จากจุดเริ่มต้น ด้วยตลับเมตร <<<")
    while True:
        try:
            x_abs = float(input("ระยะจริงตามแกน x (เมตร): "))
            y_abs = float(input("ระยะจริงตามแกน y (เมตร): "))
            break
        except ValueError:
            print("กรุณาใส่ตัวเลขเท่านั้น ลองใหม่")

    delta_x = x_abs - x_odom
    delta_y = y_abs - y_odom

    print(f"Δx = x_abs - x_odom = {x_abs:.4f} - {x_odom:.4f} = {delta_x:.4f} m")
    print(f"Δy = y_abs - y_odom = {y_abs:.4f} - {y_odom:.4f} = {delta_y:.4f} m")

    row = [
        label,
        f"{x_abs:.4f}", f"{y_abs:.4f}",
        f"{x_odom:.4f}", f"{y_odom:.4f}",
        f"{delta_x:.4f}", f"{delta_y:.4f}"
    ]
    append_row(row)
    print(f"บันทึกรอบที่ {trial_num} ลง {RESULTS_FILE} แล้ว")
    return True, row

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--direction', choices=['cw', 'ccw'], required=True)
    parser.add_argument('--trials', type=int, default=N_TRIALS, help="จำนวนรอบ (default 5)")
    args, _ = parser.parse_known_args()

    rospy.init_node('umbmark_loop', anonymous=True)
    pub = rospy.Publisher('/cmd_vel', Twist, queue_size=1)
    rospy.Subscriber('/odom', Odometry, odom_callback)
    rospy.sleep(1.0)

    print(f"เริ่มเก็บข้อมูล UMBmark: ทิศทาง {args.direction.upper()}, จำนวน {args.trials} รอบ")

    completed = 0
    trial = 1
    collected_rows = []
    while completed < args.trials and not rospy.is_shutdown():
        ok, row = run_one_trial(pub, args.direction, trial)
        if ok:
            collected_rows.append(row)
            completed += 1
            trial += 1
            if completed < args.trials:
                print(f"\n>>> นำหุ่นกลับจุดเริ่มต้นสำหรับรอบถัดไป ({completed}/{args.trials} เสร็จแล้ว) <<<")
        else:
            print("รอบนี้ล้มเหลว จะให้ลองรอบเดิมใหม่")

    print(f"\n=== เก็บข้อมูลครบ {args.trials} รอบ ({args.direction.upper()}) แล้ว ===")
    print(f"ผลลัพธ์ทั้งหมดอยู่ใน: {RESULTS_FILE}")

    # พิมพ์สรุปตารางทุกรอบขึ้นหน้าจอ เผื่อต้องจดด้วยมือ/ถ่ายรูปไปกรอกเครื่องอื่น
    print(f"\n{'='*72}")
    print(f"สรุปผล — ทิศทาง {args.direction.upper()} ({len(collected_rows)} รอบ)")
    print(f"{'='*72}")
    header = ['รอบ', 'x_abs (m)', 'y_abs (m)', 'x_odom (m)', 'y_odom (m)', 'Δx (m)', 'Δy (m)']
    print(f"{header[0]:<8}{header[1]:<12}{header[2]:<12}{header[3]:<12}{header[4]:<12}{header[5]:<10}{header[6]:<10}")
    print('-' * 76)
    sum_dx, sum_dy = 0.0, 0.0
    for r in collected_rows:
        print(f"{r[0]:<8}{r[1]:<12}{r[2]:<12}{r[3]:<12}{r[4]:<12}{r[5]:<10}{r[6]:<10}")
        sum_dx += float(r[5])
        sum_dy += float(r[6])
    if collected_rows:
        n = len(collected_rows)
        print('-' * 76)
        print(f"ค่าเฉลี่ย (x_cg, y_cg) = ({sum_dx/n:.4f}, {sum_dy/n:.4f}) m")
    print(f"\n>>> จดหรือถ่ายรูปตารางนี้ไว้ ก่อนปิด terminal ถ้าจะเอาไปกรอกเครื่องอื่น <<<")

if __name__ == '__main__':
    main()
