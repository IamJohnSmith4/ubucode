#!/bin/bash

echo "=== Starting SLAM System ==="

# Permissions
sudo chmod 666 /dev/ttyUSB0
sudo chmod 666 /dev/ttyUSB1

# Step 1 - Start laser
echo "[1] Starting laser..."
gnome-terminal -- bash -c "rosrun talker talker _serial_port:=/dev/ttyUSB1; exec bash"

# Wait for laser
echo "    Waiting for /scan..."
until rostopic echo /scan -n 1 > /dev/null 2>&1; do
    echo "    still waiting..."
    sleep 2
done
echo "    /scan OK!"

# Step 2 - Start static TF FIRST
echo "[2] Starting static TF publishers..."
gnome-terminal -- bash -c "rosrun tf static_transform_publisher 0 0 0.2 0 0 0 base_link laser_link 50; exec bash"
sleep 2

# Step 3 - Verify base_link exists
echo "    Waiting for base_link frame..."
until rosrun tf tf_echo base_link laser_link 2>&1 | grep -q "Translation"; do
    echo "    waiting for base_link..."
    sleep 1
done
echo "    base_link OK!"

# Step 4 - Start Kobuki
echo "[3] Starting Kobuki..."
gnome-terminal -- bash -c "rosrun kobuki_driver simple_keyop; exec bash"
sleep 3

# Step 5 - Start LSM
echo "[4] Starting laser_scan_matcher..."
gnome-terminal -- bash -c "rosrun laser_scan_matcher laser_scan_matcher_node _base_frame:=base_link _odom_frame:=odom _publish_tf:=true _publish_odom:=true; exec bash"

# Wait for odom→base_link
echo "    Waiting for odom->base_link..."
until rosrun tf tf_echo odom base_link 2>&1 | grep -q "Translation"; do
    echo "    waiting for odom..."
    sleep 2
done
echo "    odom->base_link OK!"

# Step 6 - Start gmapping
echo "[5] Starting gmapping..."
gnome-terminal -- bash -c "roslaunch my_robot slam.launch; exec bash"
sleep 3

# Step 7 - RViz
echo "[6] Opening RViz..."
gnome-terminal -- bash -c "rosrun rviz rviz; exec bash"
sleep 2

# Step 8 - Teleop
echo "[7] Starting teleop..."
gnome-terminal -- bash -c "rosrun teleop_twist_keyboard teleop_twist_keyboard.py cmd_vel:=/mobile_base/commands/velocity _speed:=0.15 _turn:=0.2; exec bash"

echo "=== ALL SYSTEMS GO ==="

# Terminal 1
roscore

# Terminal 2 - laser
sudo chmod 666 /dev/ttyUSB1
rosrun talker talker _serial_port:=/dev/ttyUSB1

# Terminal 3 - static TF base_link → laser_link
rosrun tf static_transform_publisher 0 0 0.2 0 0 0 base_link laser_link 50

# Terminal 4 - static TF odom → base_link (fake odom to bootstrap LSM)
rosrun tf static_transform_publisher 0 0 0 0 0 0 odom base_link 100

# Terminal 5 - NOW start LSM (it will take over odom→base_link)
rosrun laser_scan_matcher laser_scan_matcher_node \
    _base_frame:=base_link \
    _odom_frame:=odom \
    _fixed_frame:=odom \
    _publish_tf:=true \
    _publish_odom:=true \
    __log:=/tmp/lsm.log


