source /opt/ros/noetic/setup.bash
source ~/catkin_ws/devel/setup.bash
roscore

source ~/catkin_ws/devel/setup.bash
sudo chmod 666 /dev/ttyUSB0
rosrun talker talker _serial_port:=/dev/ttyUSB0

source ~/catkin_ws/devel/setup.bash
roslaunch my_robot slam.launch

Transform [sender=unknown_publisher]


nano ~/catkin_ws/src/my_robot/launch/slam.launch

<launch>

  <!-- แก้ปัญหา world → base_link โดย link world เข้ากับ map -->
  <node pkg="tf" type="static_transform_publisher" name="world_to_map"
        args="0 0 0 0 0 0 map world 50"/>

  <!-- TF: base_link → laser_link -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_laser"
        args="0 0 0.2 0 0 0 base_link laser_link 50"/>

  <!-- laser_scan_matcher สร้าง odom → base_link -->
  <node pkg="laser_scan_matcher" type="laser_scan_matcher_node"
        name="laser_scan_matcher" output="screen">
    <param name="base_frame"   value="base_link"/>
    <param name="odom_frame"   value="odom"/>
    <param name="fixed_frame"  value="odom"/>
    <param name="publish_odom" value="true"/>
    <param name="publish_tf"   value="true"/>
    <param name="use_imu"      value="false"/>
    <param name="use_odom"     value="false"/>
  </node>

  <!-- gmapping -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame"    value="base_link"/>
    <param name="odom_frame"    value="odom"/>
    <param name="map_frame"     value="map"/>
    <param name="scan"          value="/scan"/>
    <param name="maxUrange"     value="7.0"/>
    <param name="particles"     value="80"/>
    <param name="linearUpdate"  value="0.1"/>
    <param name="angularUpdate" value="0.1"/>
    <param name="delta"         value="0.05"/>
    <param name="xmin"          value="-30.0"/>
    <param name="ymin"          value="-30.0"/>
    <param name="xmax"          value="30.0"/>
    <param name="ymax"          value="30.0"/>
  </node>

</launch>
sudo apt install -y \
    ros-noetic-kobuki-driver \
    ros-noetic-kobuki-node \
    ros-noetic-kobuki-msgs \
    ros-noetic-turtlebot2-drivers \
    ros-noetic-yocs-velocity-smoother

ls /dev/ttyUSB*
# ควรเห็น ttyUSB0 (LiDAR) และ ttyUSB1 (Kobuki)
# หรืออาจเป็น ttyACM0 สำหรับ Kobuki
ls /dev/ttyACM*

sudo chmod 666 /dev/ttyUSB1
# หรือ
sudo chmod 666 /dev/ttyACM0

# Terminal ใหม่
rosrun kobuki_node kobuki_node \
    _port:=/dev/ttyACM0



# ติดตั้งแค่นี้พอ
sudo apt install ros-noetic-kobuki-driver
sudo apt install ros-noetic-kobuki-msgs


<!-- Kobuki -->
<node pkg="kobuki_driver" type="kobuki_node" name="kobuki" output="screen">
    <param name="port" value="/dev/ttyUSB1"/>
</node>

