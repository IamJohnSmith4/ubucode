source /opt/ros/noetic/setup.bash
source ~/catkin_ws/devel/setup.bash
roscore

source ~/catkin_ws/devel/setup.bash
sudo chmod 666 /dev/ttyUSB0
rosrun talker talker _serial_port:=/dev/ttyUSB0

source ~/catkin_ws/devel/setup.bash
roslaunch my_robot slam.launch

Transform [sender=unknown_publisher]


nano ~/catkin_ws/src/my_robot/launch/slam.launch

rosrun teleop_twist_keyboard teleop_twist_keyboard.py cmd_vel:=/mobile_base/commands/velocity

cd ~/catkin_ws/src

# Clone เฉพาะ kobuki_ros ไม่เอา kobuki ทั้งหมด
wget https://github.com/yujinrobot/kobuki_ros/archive/refs/heads/noetic.zip -O kobuki_ros.zip
unzip kobuki_ros.zip
mv kobuki_ros-noetic kobuki_ros
rm kobuki_ros.zip

# ติดตั้ง dependencies
sudo apt install -y \
    ros-noetic-yocs-velocity-smoother \
    ros-noetic-yocs-cmd-vel-mux \
    ros-noetic-kobuki-msgs \
    ros-noetic-diagnostics

cd ~/catkin_ws
catkin_make --pkg kobuki_node
source devel/setup.bash
