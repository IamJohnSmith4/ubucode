source /opt/ros/noetic/setup.bash
source ~/catkin_ws/devel/setup.bash
roscore

source ~/catkin_ws/devel/setup.bash
sudo chmod 666 /dev/ttyUSB0
rosrun talker talker _serial_port:=/dev/ttyUSB0

source ~/catkin_ws/devel/setup.bash
roslaunch my_robot slam.launch

Transform [sender=unknown_publisher]


nano ~/catkin_ws/src/my_robot/launch/slam.launch

rosrun teleop_twist_keyboard teleop_twist_keyboard.py cmd_vel:=/mobile_base/commands/velocity
cd ~/catkin_ws/src

# ลบอันเก่าออก
rm -rf kobuki_core

# Clone version ที่มี kobuki_node จริงๆ
git clone -b melodic https://github.com/yujinrobot/kobuki.git
git clone -b melodic https://github.com/yujinrobot/kobuki_core.git

# Build
cd ~/catkin_ws
rm -rf build devel
catkin_make
source devel/setup.bash



