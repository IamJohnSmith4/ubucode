rosrun teleop_twist_keyboard teleop_twist_keyboard.py cmd_vel:=/mobile_base/commands/velocity

sudo apt install ros-noetic-laser-filters

nano ~/catkin_ws/src/my_robot/config/laser_filter.yaml

scan_filter_chain:
- name: range
  type: laser_filters/LaserScanRangeFilter
  params:
    use_message_range_limits: false
    lower_threshold: 0.15
    upper_threshold: 5.0
    lower_replacement_value: -.inf
    upper_replacement_value: .inf

<node pkg="laser_filters" type="scan_to_scan_filter_chain"
      name="laser_filter" output="screen">
  <rosparam command="load" 
            file="$(find my_robot)/config/laser_filter.yaml"/>
  <remap from="scan" to="/scan_raw"/>
  <remap from="scan_filtered" to="/scan"/>
</node>

<launch>

  <!-- TF: base_link → laser_link -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_laser"
        args="0 0 0.2 0 0 0 base_link laser_link 50"/>

  <!-- laser_scan_matcher -->
  <node pkg="laser_scan_matcher" type="laser_scan_matcher_node"
        name="laser_scan_matcher" output="screen">
    <param name="base_frame"      value="base_link"/>
    <param name="odom_frame"      value="odom"/>
    <param name="fixed_frame"     value="odom"/>
    <param name="publish_odom"    value="true"/>
    <param name="publish_tf"      value="true"/>
    <param name="use_imu"         value="false"/>
    <param name="use_odom"        value="false"/>
    <param name="use_vel"         value="false"/>
    <param name="max_iterations"  value="10"/>
    <param name="kf_dist_linear"  value="0.1"/>
    <param name="kf_dist_angular" value="0.1"/>
  </node>

  <!-- gmapping -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame"     value="base_link"/>
    <param name="odom_frame"     value="odom"/>
    <param name="map_frame"      value="map"/>
    <param name="scan"           value="/scan"/>
    <param name="maxRange"       value="8.0"/>
    <param name="maxUrange"      value="7.0"/>
    <param name="particles"      value="50"/>
    <param name="linearUpdate"   value="0.1"/>
    <param name="angularUpdate"  value="0.1"/>
    <param name="temporalUpdate" value="1.0"/>
    <param name="delta"          value="0.05"/>
    <param name="xmin"           value="-50.0"/>
    <param name="ymin"           value="-50.0"/>
    <param name="xmax"           value="50.0"/>
    <param name="ymax"           value="50.0"/>
  </node>

</launch>
<launch>


  <!-- odom → base_link (static ชั่วคราว) -->
  <node pkg="tf" type="static_transform_publisher" name="odom_to_base"
        args="0 0 0 0 0 0 odom base_link 50"/>
        
  <!-- TF: base_link → laser_link -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_laser"
        args="0 0 0.2 0 0 0 base_link laser_link 50"/>

  <!-- laser_scan_matcher สร้าง odom → base_link -->
  <node pkg="laser_scan_matcher" type="laser_scan_matcher_node"
        name="laser_scan_matcher" output="screen">
    <param name="base_frame"   value="base_link"/>
    <param name="odom_frame"   value="odom"/>
    <param name="fixed_frame"  value="odom"/>
    <param name="publish_odom" value="true"/>
    <param name="publish_tf"   value="true"/>
    <param name="use_imu"      value="false"/>
    <param name="use_odom"     value="false"/>
    <param name="use_vel"         value="false"/>
    <param name="max_iterations"  value="10"/>
    <param name="kf_dist_linear"  value="0.3"/>
    <param name="kf_dist_angular" value="0.3"/>
    <param name="sigma"	   value="0.05"/>
    <param name="use_ll_scale"    value="false"/>
  </node>

  <!-- gmapping -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame"    value="base_link"/>
    <param name="odom_frame"    value="odom"/>
    <param name="map_frame"     value="map"/>
    <param name="scan"          value="/scan"/>
    <param name="maxRange"    value="5.0"/>
    <param name="maxUrange"   value="4.5"/>
    <param name="lsigma"      value="0.075"/>
    <param name="ogain"       value="3.0"/>
    <param name="particles"     value="30"/>
    <param name="linearUpdate"  value="0.5"/>
    <param name="angularUpdate" value="0.5"/>    	
    <param name="temporalUpdate" value="1.0"/>
    <param name="resampleThreshold" value="0.5"/>
    <param name="lskip"          value="0"/>
    <param name="minimumScore" value="200"/>
    <param name="srr"  value="0.1"/>
    <param name="srt"  value="0.2"/>
    <param name="str"  value="0.1"/>
    <param name="stt"  value="0.2"/>
    <param name="delta"         value="0.05"/>
    <param name="xmin"          value="-30.0"/>
    <param name="ymin"          value="-30.0"/>
    <param name="xmax"          value="30.0"/>
    <param name="ymax"          value="30.0"/>
  </node>
  
  
</launch>

