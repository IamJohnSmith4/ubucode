#!/bin/bash

echo "=== Starting SLAM System ==="

# Permissions
sudo chmod 666 /dev/ttyUSB0
sudo chmod 666 /dev/ttyUSB1

# Start laser
echo "[1] Starting laser..."
gnome-terminal -- bash -c "rosrun talker talker _serial_port:=/dev/ttyUSB1; exec bash"

# Wait for laser
echo "[2] Waiting for laser scan..."
until rostopic hz /scan --window=5 2>/dev/null | grep -q "average rate"; do
    echo "   waiting for /scan..."
    sleep 2
done
echo "   /scan OK!"

# Start Kobuki
echo "[3] Starting Kobuki..."
gnome-terminal -- bash -c "rosrun kobuki_driver simple_keyop; exec bash"
sleep 3

# Start SLAM
echo "[4] Starting SLAM..."
gnome-terminal -- bash -c "roslaunch my_robot slam.launch; exec bash"

# Wait for LSM to publish odom→base_link
echo "[5] Waiting for odom→base_link..."
until rosrun tf tf_echo odom base_link 2>&1 | grep -q "Translation"; do
    echo "   waiting for TF..."
    sleep 2
done
echo "   TF OK!"

# Open RViz
echo "[6] Opening RViz..."
gnome-terminal -- bash -c "rosrun rviz rviz; exec bash"
sleep 2

# Teleop
echo "[7] Starting teleop..."
gnome-terminal -- bash -c "rosrun teleop_twist_keyboard teleop_twist_keyboard.py cmd_vel:=/mobile_base/commands/velocity _speed:=0.15 _turn:=0.2; exec bash"

echo "=== ALL SYSTEMS GO ==="

