@app.route('/command/reset-home', methods=['POST'])
def handle_reset_home():
    global is_navigating, current_location, current_progress

    with state_lock:
        if is_navigating:
            return jsonify({"status": "error", "message": "Robot is busy"}), 400
        loc = current_location

    if loc == 10:
        return jsonify({"status": "already_there",
                        "message": "Already at Node 10 (home)"}), 200

    def run_home():
        global is_navigating, current_location, current_progress
        with state_lock:
            is_navigating    = True
            current_progress = 0.0
            last_node        = current_location

        # Node 3 must pass through Node 2 first
        if last_node == 3:
            rospy.loginfo("[Home] From Node 3 — going to Node 2 first.")
            success = my_robot.navigate_to_node(2)
            if not success:
                rospy.logwarn("[Home] Failed to reach Node 2. Aborting.")
                with state_lock:
                    is_navigating = False
                return
            with state_lock:
                current_location = 2
            rospy.loginfo("[Home] Node 2 reached — continuing to Node 10.")
            rospy.sleep(0.5)

        success = my_robot.navigate_to_node(10)
        with state_lock:
            is_navigating = False
            if success:
                current_location = 10
                current_progress = 100.0
                rospy.loginfo("[Home] Arrived at Node 10 (home).")
            else:
                rospy.logwarn("[Home] Failed to reach Node 10.")

    route = [2, 10] if loc == 3 else [10]
    threading.Thread(target=run_home, daemon=True).start()
    return jsonify({"status": "starting", "from_node": loc,
                    "target_node": 10, "route": route}), 200


