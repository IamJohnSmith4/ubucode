#!/usr/bin/env python3
# fix_scan_stamp.py
# Republishes /scan → /scan_fixed with ros::Time::now()
# Uses queue_size=1 and buff_size to minimize latency

import rospy
from sensor_msgs.msg import LaserScan

pub = None

def callback(msg):
    msg.header.stamp = rospy.Time.now()
    pub.publish(msg)

if __name__ == "__main__":
    rospy.init_node("fix_scan_stamp", anonymous=False)

    pub = rospy.Publisher(
        "/scan_fixed",
        LaserScan,
        queue_size=1        # never queue — always publish latest
    )

    rospy.Subscriber(
        "/scan",
        LaserScan,
        callback,
        queue_size=1,       # drop old scans, only process latest
        buff_size=2**24     # large buffer so we never block on receive
    )

    rospy.loginfo("[fix_scan_stamp] Running: /scan → /scan_fixed with corrected timestamps")
    rospy.spin()


<launch>
  <!-- Bridge between base_footprint and base_link -->
  <node pkg="tf" type="static_transform_publisher" 
        name="footprint_to_base"
        args="0 0 0 0 0 0 base_footprint base_link 50"/>

  <!-- Laser TF — matches slam.launch exactly -->
  <node pkg="tf" type="static_transform_publisher" 
        name="base_to_laser"
        args="0 0 0.2 0 0 0 base_link laser_link 50"/>

  <!-- ================================================== -->
  <!-- Scan timestamp fix for Leishen LS01D               -->
  <!-- Republishes /scan → /scan_fixed with ros::Time::now() -->
  <!-- Fixes the -0.9s odom TF delay                      -->
  <!-- ================================================== -->
  <node pkg="my_robot" type="fix_scan_stamp.py" 
        name="fix_scan_stamp" output="screen"/>

  <!-- map_server -->
  <node pkg="map_server" type="map_server" name="map_server"
        args="/home/ubutu2004/map/final.yaml"
        output="screen"/>

  <!-- AMCL — using /scan_fixed instead of /scan -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen"
        respawn="true">
    <remap from="scan" to="scan_fixed"/>   <!-- KEY: use corrected timestamps -->
    <param name="use_map_topic"       value="false"/>
    <param name="tf_broadcast"        value="true"/>
    <param name="odom_model_type"     value="diff"/>
    <param name="odom_frame_id"       value="odom"/>
    <param name="base_frame_id"       value="base_footprint"/>
    <param name="global_frame_id"     value="map"/>
    <param name="laser_model_type"    value="likelihood_field"/>
    <param name="min_particles"       value="500"/>
    <param name="max_particles"       value="2000"/>
    <param name="laser_max_range"     value="7.0"/>
    <param name="laser_max_beams"     value="90"/>
    <param name="update_min_d"        value="0.1"/>
    <param name="update_min_a"        value="0.1"/>
    <param name="transform_tolerance"    value="0.2"/>  <!-- tight now that scan stamps are fixed -->
    <param name="transform_publish_delta" value="0.05"/> <!-- publish map->odom TF more frequently -->
    <param name="initial_pose_x"      value="0.0"/>
    <param name="initial_pose_y"      value="0.0"/>
    <param name="initial_pose_a"      value="0.0"/>
    <param name="gui_publish_rate"    value="10.0"/>
    <param name="recovery_alpha_slow" value="0.001"/>
    <param name="recovery_alpha_fast" value="0.1"/>
  </node>

  <!-- move_base — using /scan_fixed in costmaps too -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find my_robot)/config/costmap_common.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find my_robot)/config/costmap_common.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find my_robot)/config/global_costmap.yaml"
              command="load"/>
    <rosparam file="$(find my_robot)/config/local_costmap.yaml"
              command="load"/>
    <rosparam file="$(find my_robot)/config/base_local_planner.yaml"
              command="load"/>

    <!-- Remap scan for costmap obstacle layer -->
    <remap from="scan" to="scan_fixed"/>

    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner"  value="base_local_planner/TrajectoryPlannerROS"/>
    <remap from="cmd_vel"             to="/mobile_base/commands/velocity"/>

    <param name="controller_frequency"      value="5.0"/>
    <param name="planner_patience"          value="10.0"/>
    <param name="controller_patience"       value="20.0"/>
    <param name="conservative_reset_dist"   value="3.0"/>
    <param name="recovery_behavior_enabled" value="false"/>
    <param name="clearing_rotation_allowed" value="false"/>
    <param name="planner_frequency"         value="1.0"/>
  </node>

</launch>






