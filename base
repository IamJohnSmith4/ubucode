TrajectoryPlannerROS:
  # Speed settings
  max_vel_x: 0.12         # increase from default
  min_vel_x: 0.05          # minimum forward speed
  max_vel_theta: 0.4      # max rotation speed
  min_in_place_vel_theta: 0.2  # min rotation speed
  
  # Acceleration 
  acc_lim_x: 0.1
  acc_lim_theta: 0.3
  
  # Path following
  holonomic_robot: false
  sim_time: 2.0           # how far ahead to simulate
  sim_granularity: 0.02
  vx_samples: 10          # speed samples
  vtheta_samples: 20      # rotation samples
  
  # Goal tolerance
  xy_goal_tolerance: 0.3  # stop within 30cm of goal
  yaw_goal_tolerance: 0.5 # stop within 0.5 rad of goal angle
  latch_xy_goal_tolerance: true
  
  # Path tolerance — KEY for stopping spin
  pdist_scale: 0.8        # how much to follow path
  gdist_scale: 0.6        # how much to go toward goal
  occdist_scale: 0.05      # obstacle avoidance weight
  
  # Stop oscillation/spinning
  oscillation_reset_dist: 0.1
  escape_vel: -0.05
  escape_reset_dist: 0.1
  escape_reset_theta: 0.1
  meter_scoring: true

global_costmap:
  global_frame: map
  robot_base_frame: base_footprint
  update_frequency: 1.0
  publish_frequency: 1.0
  static_map: true
  transform_tolerance: 0.5

  plugins:
    - {name: static_layer, type: "costmap_2d::StaticLayer"}
    - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
    
  inflation_layer:
   inflation_radius: 0.35
   cost_scaling_factor: 5.0

obstacle_range: 2.5
raytrace_range: 3.0
robot_radius: 0.20

observation_sources: laser_scan_sensor
laser_scan_sensor:
  sensor_frame: laser_link
  data_type: LaserScan
  topic: /scan_fixed
  marking: true
  clearing: true

local_costmap:
  global_frame: odom
  robot_base_frame: base_footprint
  update_frequency: 5.0
  publish_frequency: 2.0
  static_map: false
  rolling_window: true
  width: 4.0
  height: 3.0
  resolution: 0.05
  plugins:
    - {name: obstacle_layer, type: "costmap_2d::ObstacleLayer"}
    - {name: inflation_layer, type: "costmap_2d::InflationLayer"}
    
  inflation_layer:
   inflation_radius: 0.25
   cost_scaling_factor: 3.0
