TrajectoryPlannerROS:
  max_vel_x: 0.12          # reduce from 0.15
  min_vel_x: 0.05
  max_vel_theta: 0.4
  min_in_place_vel_theta: 0.2

  acc_lim_x: 0.1           # KEY — lower this, Kobuki ramps slowly
  acc_lim_theta: 0.3       # lower this too

  holonomic_robot: false
  sim_time: 2.0            # increase from 1.5
  sim_granularity: 0.025
  vx_samples: 10
  vtheta_samples: 20

  xy_goal_tolerance: 0.3
  yaw_goal_tolerance: 0.5
  latch_xy_goal_tolerance: true

  pdist_scale: 0.8
  gdist_scale: 0.6
  occdist_scale: 0.05

  oscillation_reset_dist: 0.1
  escape_vel: -0.05
  escape_reset_dist: 0.1
  escape_reset_theta: 0.1
  meter_scoring: true
