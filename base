app      = Flask(__name__)
my_robot = None


def _resolve_planned_sequence(loc, target):
    """Preview the planned waypoints for the API response."""
    if loc == target:
        return []
    if loc == 2 and target == 3:
        return [3]
    if loc == 3 and target == 2:
        return [2]
    if target == 10:
        if loc == 3:
            return [2, 10]
        return [10]
    if target in (1, 2, 3):
        corridor = [1, 2, 3]
        if loc in corridor and target in corridor:
            li = corridor.index(loc)
            ti = corridor.index(target)
            if ti > li:
                return corridor[li + 1: ti + 1]
            return [target]
        if loc == 10:
            return [target] if target in (1, 2) else [2, 3]
    return [target]


@app.route('/command', methods=['POST'])
def handle_command():
    global is_navigating, current_progress

    data   = request.json or {}
    target = data.get('target')

    with state_lock:
        loc = current_location
        if is_navigating:
            return jsonify({"status": "error", "message": "Robot is busy"}), 400

    if not my_robot.amcl_ready:
        rospy.logwarn(f"[API] AMCL not ready (cov={my_robot.amcl_covariance:.4f}) — using odom only")

    if target not in NODE_POSES:
        return jsonify({"status": "error",
                        "message": f"Node {target} not in NODE_POSES"}), 400

    if target == loc:
        return jsonify({"status": "already_there",
                        "message": f"Already at Node {target}"}), 200

    planned_sequence = _resolve_planned_sequence(loc, target)

    def run_and_finish(t):
        global is_navigating, current_location, current_progress
        with state_lock:
            current_progress = 0.0
            is_navigating    = True
        success = my_robot.execute_path(t)
        with state_lock:
            is_navigating = False
            if success:
                current_location = t

    threading.Thread(target=run_and_finish, args=(target,), daemon=True).start()

    return jsonify({
        "status":           "starting",
        "from_node":        loc,
        "target_node":      target,
        "target_pose":      NODE_POSES[target],
        "planned_sequence": planned_sequence,
    }), 200


