<launch>

  <!-- TF: base_link → laser_link ONLY (do NOT publish odom→base_link statically) -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_laser"
        args="0 0 0.2 0 0 0 -1.5708 base_link laser_link 50"/>
        
  <node pkg="tf" type="static_transform_publisher" name="odom_to_base"
        args="0 0 0 0 0 0 odom base_link 50"/>


  <!-- gmapping -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame"      value="base_link"/>
    <param name="odom_frame"      value="odom"/>
    <param name="map_frame"       value="map"/>
    <param name="scan"            value="/scan"/>  <!-- must match your lidar topic -->
    <param name="maxRange"        value="8.0"/>
    <param name="maxUrange"       value="7.0"/>
    <param name="particles"       value="50"/>
    <param name="linearUpdate"    value="0.1"/>
    <param name="angularUpdate"   value="0.1"/>
    <param name="temporalUpdate"  value="1.0"/>
    <param name="delta"           value="0.05"/>
    <param name="xmin"            value="-50.0"/>
    <param name="ymin"            value="-50.0"/>
    <param name="xmax"            value="50.0"/>
    <param name="ymax"            value="50.0"/>
  </node>
</launch>


<launch>

  <!-- ============================================================
       TF: base_link → laser_link
       Adjust xyz/rpy to match your actual LiDAR mounting.
       args="x y z yaw pitch roll parent_frame child_frame rate_hz"
       Current: LiDAR mounted 20cm up, rotated 180° (upside-down).
  ============================================================ -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_laser"
        args="0 0 0.2 3.14159 0 0 base_link laser_link 50"/>

  <!-- ============================================================
       Temporary map → odom static TF
       Keeps gmapping from crashing at startup before it
       publishes its own map→odom.  Remove if gmapping is stable.
  ============================================================ -->
  <node pkg="tf" type="static_transform_publisher" name="map_to_odom"
        args="0 0 0 0 0 0 map odom 50"/>

  <!-- ============================================================
       laser_scan_matcher
       Publishes: odom → base_link  (dynamic, from scan matching)
  ============================================================ -->
  <node pkg="laser_scan_matcher" type="laser_scan_matcher_node"
        name="laser_scan_matcher" output="screen">

    <param name="base_frame"              value="base_link"/>
    <param name="odom_frame"              value="odom"/>
    <param name="fixed_frame"             value="map"/>    <!-- FIXED: was odom -->

    <param name="publish_odom"            value="true"/>
    <param name="publish_tf"              value="true"/>
    <param name="tf_delay"                value="0.05"/>   <!-- ADDED: prevents extrapolation -->

    <param name="use_imu"                 value="false"/>
    <param name="use_odom"                value="false"/>
    <param name="use_vel"                 value="false"/>

    <param name="max_iterations"          value="10"/>
    <param name="kf_dist_linear"          value="0.1"/>    <!-- tightened from 0.3 -->
    <param name="kf_dist_angular"         value="0.1"/>    <!-- tightened from 0.3 -->
    <param name="max_correspondence_dist" value="0.4"/>
    <param name="use_ll_scale"            value="true"/>
    <param name="outlier_reject"          value="0.9"/>
  </node>

  <!-- ============================================================
       gmapping  (SLAM — builds the map)
  ============================================================ -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">

    <param name="base_frame"      value="base_link"/>
    <param name="odom_frame"      value="odom"/>
    <param name="map_frame"       value="map"/>
    <param name="scan"            value="/scan"/>

    <!-- Laser range -->
    <param name="maxRange"        value="8.0"/>
    <param name="maxUrange"       value="7.0"/>

    <!-- Particle filter -->
    <param name="particles"       value="50"/>

    <!-- Update triggers — lower = more frequent map updates -->
    <param name="linearUpdate"    value="0.1"/>
    <param name="angularUpdate"   value="0.1"/>
    <param name="temporalUpdate"  value="-1"/>   <!-- FIXED: -1 = every scan -->

    <!-- Map resolution -->
    <param name="delta"           value="0.05"/>

    <!-- Initial map bounds (metres) -->
    <param name="xmin"            value="-50.0"/>
    <param name="ymin"            value="-50.0"/>
    <param name="xmax"            value="50.0"/>
    <param name="ymax"            value="50.0"/>

    <!-- Sensor model -->
    <param name="sigma"           value="0.05"/>
    <param name="kernelSize"      value="1"/>
    <param name="lstep"           value="0.05"/>
    <param name="astep"           value="0.05"/>
    <param name="iterations"      value="5"/>
    <param name="lsigma"          value="0.075"/>
    <param name="ogain"           value="3.0"/>
    <param name="lskip"           value="0"/>

    <!-- Occupancy thresholds -->
    <param name="minimumScore"    value="0.0"/>
    <param name="srr"             value="0.1"/>
    <param name="srt"             value="0.2"/>
    <param name="str"             value="0.1"/>
    <param name="stt"             value="0.2"/>
  </node>

</launch>



