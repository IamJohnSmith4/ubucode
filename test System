nano ~/record_test.sh

#!/bin/bash
NODE=$1
echo "=== Node $NODE ===" >> ~/test_results.txt
echo "Time: $(date)" >> ~/test_results.txt
curl -s http://localhost:5000/status | python3 -c "
import sys, json
d = json.load(sys.stdin)
print(f'AMCL x: {d[\"amcl_position\"][\"x\"]}')
print(f'AMCL y: {d[\"amcl_position\"][\"y\"]}')
print(f'Source: {d[\"pose_source\"]}')
print(f'Cov:    {d[\"amcl_covariance\"]}')
" >> ~/test_results.txt
echo "---" >> ~/test_results.txt

chmod +x ~/record_test.sh

# Home → ห้อง A
curl -X POST http://localhost:5000/command \
  -H "Content-Type: application/json" \
  -d '{"target": 2}'

# รอหุ่นถึงแล้วบันทึกตำแหน่ง
curl http://localhost:5000/status

~/record_test.sh 2 

# ห้อง A → ห้อง B
curl -X POST http://localhost:5000/command \
  -H "Content-Type: application/json" \
  -d '{"target": 3}'

# ห้อง B → Home
curl -X POST http://localhost:5000/command \
  -H "Content-Type: application/json" \
  -d '{"target": 10}'

~/record_test.sh 2   # หลังถึงห้อง A
~/record_test.sh 3   # หลังถึงห้อง B
~/record_test.sh 10  # หลังกลับ Home

