NODE_POSES = {
    1: {"x":  0.000, "y":  0.000, "yaw_rad": 0.0},
    2: {"x": 12.493, "y":  0.092, "yaw_rad": 0.0},
    3: {"x": 21.839, "y": -4.072, "yaw_rad": 0.0},
}

